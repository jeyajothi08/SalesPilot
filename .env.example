# ============================================================
# SalesPilot AI — Environment Variables Template
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64
DEBUG=false

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=CHANGE_ME_use_strong_password
POSTGRES_DB=salespilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://salespilot:CHANGE_ME@postgres:5432/salespilot_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_use_strong_password
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/1

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
ELEVENLABS_API_KEY=

# ── Email ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@salespilot.ai
SENDGRID_FROM_NAME=SalesPilot AI

# ── Telephony (Twilio) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...

# ── Messaging (Meta WhatsApp) ────────────────────────────────
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# ── Payments (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Storage (AWS S3 / Compatible) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=salespilot-prod-uploads
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=     # Leave empty for AWS, set for MinIO/R2

# ── Docker / Registry ────────────────────────────────────────
DOCKER_REGISTRY=ghcr.io/yourorg
IMAGE_TAG=latest

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME
SENTRY_DSN=https://...@sentry.io/...

# ── CORS & Frontend ──────────────────────────────────────────
BACKEND_CORS_ORIGINS=["https://app.salespilot.ai","https://salespilot.ai"]
VITE_API_URL=https://api.salespilot.ai
VITE_APP_ENV=production

# ── Email SMTP (for Grafana alerts) ──────────────────────────
SMTP_HOST=smtp.sendgrid.net:587
SMTP_USER=apikey
